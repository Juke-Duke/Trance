  "tokenColors": [
    {
      "name": "Source",
      "scope": [
        "source",
      ],
      "settings": {
        "foreground": "#A3A8C2",
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
      ],
      "settings": {
        "foreground": "#3C406E",
        "fontStyle": "italic",
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "support.constant",
      ],
      "settings": {
        "foreground": "#00AAFF",
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.class",
        "entity.name.tag",
        "entity.name.type",
        "meta.tag",
        "support.class",
        "support.type",
      ],
      "settings": {
        "foreground": "#8095FF",
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function",
        "meta.function-call",
        "support.function",
      ],
      "settings": {
        "foreground": "#667FFF",
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
      ],
      "settings": {
        "foreground": "#FF4D6A",
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage",
        "variable.language",
      ],
      "settings": {
        "foreground": "#9966FF",
      }
    },
    {
      "name": "Operator",
      "scope": [
        "constant.character.escape",
        "keyword.operator",
        "meta.block",
        "punctuation",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end",
      ],
      "settings": {
        "foreground": "#66CCFF",
      }
    },
    {
      "name": "String",
      "scope": [
        "string.quoted",
        "string.unquoted",
      ],
      "settings": {
        "foreground": "#00FFFF",
      }
    },
    {
      "name": "Variable",
      "scope": [
        "entity.other.attribute-name",
        "meta.definition.type.body",
        "variable",
      ],
      "settings": {
        "foreground": "#B3BFFF",
      }
    },
    {
      "name": "Markdown Heading",
      "scope": [
        "fenced_code.block.language",
        "markup.heading.markdown",
      ],
      "settings": {
        "foreground": "#8095FF",
        "fontStyle": "bold",
      }
    },
    {
      "name": "Markdown Punctuation",
      "scope": [
        "punctuation.definition.markdown",
        "punctuation.definition.bold.markdown",
        "punctuation.definition.heading.markdown",
        "punctuation.definition.italic.markdown",
        "punctuation.definition.link.title.begin.markdown",
        "punctuation.definition.link.title.end.markdown",
        "punctuation.definition.list.begin.markdown",
        "punctuation.definition.list.end.markdown",
        "punctuation.definition.metadata.markdown",
        "punctuation.definition.raw.markdown",
        "punctuation.definition.strikethrough.markdown",
        "punctuation.definition.quote.begin.markdown",
        "punctuation.definition.quote.end.markdown",
        "punctuation.definition.link.description.begin.markdown",
        "punctuation.definition.link.description.end.markdown",
        "meta.separator.markdown",
      ],
      "settings": {
        "foreground": "#3C406E",
      }
    },
    {
      "name": "Markdown Link",
      "scope": [
        "markup.underline.link.markdown",
      ],
      "settings": {
        "foreground": "#8095FF",
      }
    }
  ],
}
